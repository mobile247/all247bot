# all247 — Environment Configuration Example
# Copy to .env and fill in your values. Never commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────────────

# Telegram Bot API token from @BotFather
BOT_TOKEN=your-telegram-bot-token-here

# ── Optional ──────────────────────────────────────────────────────────────────

# Path to SQLite database file inside the container
DB_PATH=./data/all247.db

# Logging level: INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Webhook mode (leave unset for long polling — recommended for most setups)
# WEBHOOK_URL=https://your-domain.com/webhook
# WEBHOOK_PORT=8443

# Default cooldown in seconds for new groups (0 = disabled)
DEFAULT_COOLDOWN_SECONDS=0

# Days to retain rate limit log entries before purging (0 = keep forever)
RATE_LIMIT_PURGE_DAYS=7

# Stale member pruning (0 = disabled)
# Members with no activity beyond this threshold are set inactive
# STALE_MEMBER_PRUNE_DAYS=0

# Override hard cap for mentionable members (default: 1000)
# Only increase if you understand the Telegram API flood risk
# MAX_MENTIONABLE_MEMBERS=1000
